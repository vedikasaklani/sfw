APP_ENV=development
APP_NAME=Modern Library Portal
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./library_portal.db
FRONTEND_ORIGIN=http://localhost:5173
# Add comma-separated origins here when the frontend is opened from another host/IP.
FRONTEND_ORIGINS=http://127.0.0.1:5173
DEMO_MODE=false
# Host-side backend: http://localhost:8081. The API prefix is appended below.
KOHA_BASE_URL=http://localhost:8081
KOHA_OPAC_URL=http://localhost:8080
KOHA_API_PREFIX=/api/v1
KOHA_AUTH_METHOD=oauth2
KOHA_API_TOKEN=
KOHA_CLIENT_ID=
KOHA_CLIENT_SECRET=
KOHA_BASIC_USERNAME=
KOHA_BASIC_PASSWORD=
KOHA_TOKEN_PATH=/oauth/token
APP_SESSION_SECRET=generate-a-random-32-byte-secret-before-use
SESSION_COOKIE_SECURE=false
